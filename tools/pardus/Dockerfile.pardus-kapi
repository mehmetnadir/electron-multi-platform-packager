# PARDUS KABUL KAPISI — KONTEYNER KATMANI (tier-1)
#
# Taban RESMİ Pardus 23.4 (yirmiuc) imajıdır — ProBook'taki ETAP 23.4 ile AYNI sürüm.
# Debian taklidi DEĞİL: kütüphane sürümleri, Chromium sandbox davranışı ve zenity
# aynı depodan gelir.
#
# Bu kapı ProBook'un YERİNE GEÇMEZ, ÖNÜNE geçer:
#   konteyner  -> beyaz ekran / içeriksiz pencere / çöken uygulama sınıfını dakikalar
#                 içinde, donanım beklemeden yakalar (WebP ve SET menüsü kararlarının
#                 önündeki tıkanıklık buydu)
#   ProBook    -> yayın yetkisi (K18: "her yaptığını pardus'ta aç, doğrulayıp öyle yükle")
#
# Ölçüm ProBook ile BİREBİR aynı: import -window + gri tonda standart sapma,
# koyu piksel oranı, renk sayısı. Eşikler tek yerde (probook-kabul.sh ile aynı).
FROM pardus/yirmiuc:latest

ENV DEBIAN_FRONTEND=noninteractive

# TAVUK-YUMURTA (2026-09-20 ölçüldü): taban imajda `ca-certificates` YOK; depo
# adresi http ama sunucu https'e yönlendiriyor -> "Certificate verification failed"
# -> apt index'i hiç inmiyor -> her paket "bulunamadı" görünüyor (exit 100).
# Bu ilk turda doğrulama bilerek kapatılır, SADECE ca-certificates kurulur,
# sonraki turlar normal doğrulamalı çalışır.
RUN apt-get -o Acquire::https::Verify-Peer=false -o Acquire::AllowInsecureRepositories=true update \
 && apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends --allow-unauthenticated \
      ca-certificates \
 && update-ca-certificates

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11-utils xdotool imagemagick \
      libfuse2 squashfs-tools fuse \
      zenity python3-gi gir1.2-gtk-3.0 \
      libgtk-3-0 libnss3 libasound2 libatk-bridge2.0-0 libatk1.0-0 \
      libcups2 libdrm2 libgbm1 libxkbcommon0 libxcomposite1 libxdamage1 \
      libxrandr2 libxfixes3 libpango-1.0-0 libcairo2 libxshmfence1 libx11-xcb1 \
      fonts-dejavu-core fonts-liberation \
      procps psmisc curl ca-certificates \
      unzip zip xz-utils tar file desktop-file-utils \
  && rm -rf /var/lib/apt/lists/*

# ImageMagick'in varsayılan ilkesi bazı biçimleri kısıtlar; ekran görüntüsü almak
# icin PNG ve X11 okuma serbest olmali (aksi halde olcum sessizce bos doner).
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
      sed -i 's/rights="none" pattern="PNG"/rights="read|write" pattern="PNG"/' /etc/ImageMagick-6/policy.xml || true; \
    fi

# AppImage'ler root'ta calismaz (--appimage-extract-and-run ile calisir ama
# uygulamanin kendisi root sandbox'ina takilir) — gercek makinedeki gibi normal
# kullanici kullanilir.
RUN useradd -m -s /bin/bash etapadmin
COPY konteyner-kapi.sh /usr/local/bin/konteyner-kapi
RUN chmod +x /usr/local/bin/konteyner-kapi

USER etapadmin
WORKDIR /home/etapadmin
ENTRYPOINT ["/usr/local/bin/konteyner-kapi"]
